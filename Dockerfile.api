FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system vtms && adduser --system --ingroup vtms vtms

COPY pyproject.toml ./
COPY src ./src

RUN python -m pip install --upgrade pip && \
    python -m pip install ".[api]"

USER vtms

EXPOSE 8000

CMD ["sh", "-c", "uvicorn vtms_api.app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
